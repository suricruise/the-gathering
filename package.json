{
  "name": "the-gathering",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "next start --hostname 0.0.0.0",
    "test:e2e": "playwright test",
    "db:start": "SUPABASE_HOME=/workspace/.supabase-cli supabase start --exclude studio,realtime,edge-runtime,logflare,vector,supavisor,imgproxy",
    "db:migrate": "SUPABASE_HOME=/workspace/.supabase-cli supabase migration up --local",
    "test:db": "node scripts/test-db.mjs",
    "test:integration": "node scripts/test-supabase.mjs",
    "db:test-stack": "node scripts/test-stack.mjs",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:bundle": "node scripts/check-client-secrets.mjs",
    "db:seed:communities": "node scripts/seed-communities.mjs",
    "test:communities": "node scripts/test-communities.mjs",
    "test:messaging": "node scripts/test-messaging.mjs",
    "test:realtime": "node scripts/test-chat-realtime.mjs",
    "chat:cleanup": "node scripts/cleanup-chat-files.mjs",
    "voice:local": "node scripts/voice-local.mjs",
    "voice:worker": "node scripts/voice-worker.mjs",
    "test:voice": "node scripts/test-voice.mjs",
    "test:voice:setup": "node scripts/test-voice-setup.mjs",
    "test:voice:worker": "node --test scripts/test-voice-enforcement.mjs",
    "test:social": "node scripts/test-social.mjs",
    "test:social:setup": "node scripts/test-social-setup.mjs",
    "social:cleanup": "node scripts/cleanup-social-files.mjs",
    "test:squads": "node scripts/test-squads.mjs && node scripts/test-squad-concurrency.mjs",
    "test:squads:setup": "node scripts/test-squad-setup.mjs",
    "squad:cleanup": "node scripts/cleanup-squads.mjs",
    "test:people": "node scripts/test-people.mjs",
    "test:people:realtime": "node scripts/test-people-realtime.mjs",
    "test:people:setup": "node scripts/test-people-setup.mjs",
    "test:spaces": "node scripts/test-spaces.mjs",
    "test:spaces:realtime": "node scripts/test-space-realtime.mjs",
    "test:spaces:setup": "node scripts/test-spaces-setup.mjs",
    "notifications:reminders": "node scripts/deliver-event-reminders.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:admin:setup": "node scripts/test-admin-setup.mjs",
    "moderation:cleanup": "node scripts/cleanup-moderation.mjs",
    "test:admin:api": "node scripts/test-admin-api.mjs",
    "prebuild": "node scripts/check-environment.mjs && node scripts/build-pwa.mjs",
    "check:production": "node scripts/check-environment.mjs --production",
    "test:launch": "node scripts/test-launch.mjs",
    "test:security": "node scripts/security-audit.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:launch:setup": "node scripts/test-launch-setup.mjs",
    "community:cleanup": "node scripts/cleanup-community-headers.mjs",
    "test:community:headers": "node scripts/test-community-headers.mjs",
    "test:community:headers:setup": "node scripts/test-community-headers-setup.mjs",
    "test:community:management": "node scripts/test-community-management.mjs",
    "test:community:management:setup": "node scripts/test-community-management-setup.mjs",
    "pwa:assets": "node scripts/build-pwa.mjs",
    "test:members": "node scripts/test-member-directory.mjs",
    "test:members:setup": "node scripts/test-member-directory-setup.mjs",
    "test:people:rail": "node scripts/test-people-rail.mjs",
    "test:people:rail:setup": "node scripts/test-people-rail-setup.mjs",
    "test:public:defaults": "node scripts/test-public-defaults.mjs",
    "test:members:rail": "node scripts/test-all-member-rail.mjs",
    "test:members:rail:setup": "node scripts/test-all-member-rail-setup.mjs",
    "test:workspace": "node scripts/test-channel-workspace.mjs",
    "test:workspace:setup": "node scripts/test-channel-workspace-setup.mjs",
    "test:interactions": "node scripts/test-message-interactions.mjs",
    "test:interactions:setup": "node scripts/test-message-interactions-setup.mjs",
    "test:threads": "node scripts/test-channel-threads.mjs",
    "test:threads:setup": "node scripts/test-channel-threads-setup.mjs",
    "test:chat:reliability": "node scripts/test-chat-reliability.mjs",
    "test:chat:reliability:setup": "node scripts/test-chat-reliability-setup.mjs",
    "test:chat:navigation": "node scripts/test-chat-navigation.mjs",
    "test:chat:navigation:setup": "node scripts/test-chat-navigation-setup.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@livekit/components-react": "^2.9.24",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.14.22",
    "ipaddr.js": "^2.5.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.468.0",
    "mp4box": "^2.4.1",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
