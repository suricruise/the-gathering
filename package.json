{
  "name": "the-gathering",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "next start --hostname 0.0.0.0",
    "test:e2e": "playwright test",
    "db:start": "SUPABASE_HOME=/workspace/.supabase-cli supabase start --exclude studio,realtime,edge-runtime,logflare,vector,supavisor,imgproxy",
    "db:migrate": "SUPABASE_HOME=/workspace/.supabase-cli supabase migration up --local",
    "test:db": "node scripts/test-db.mjs",
    "test:integration": "node scripts/test-supabase.mjs",
    "db:test-stack": "node scripts/test-stack.mjs",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:bundle": "node scripts/check-client-secrets.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0",
    "@vitejs/plugin-react": "^4.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
