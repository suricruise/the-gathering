# Copy to .env.local for manual local setup; never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY: a Supabase secret key, or legacy service-role key. Never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Canonical origin, used for email links. Set HTTPS on public deployments.
APP_URL=http://127.0.0.1:3000

# Server-only LiveKit configuration. Never prefix the API key/secret with NEXT_PUBLIC.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SERVER ONLY: random token of at least 32 characters for private operational health.
OPS_HEALTH_TOKEN=
